# Cache shared by the API and exactly one scheduled worker.
HLTV_DATABASE_PATH=data/hltv-service.sqlite
HLTV_BROWSER=chrome
HLTV_HEADLESS=true
HLTV_BROWSER_PROFILE_PATH=
HLTV_MINIMUM_REQUEST_INTERVAL=3
HLTV_PAGE_TIMEOUT=30
HLTV_ENABLED_REGIONS=
HLTV_MAX_MATCH_DETAILS_PER_RUN=25
HLTV_MAX_EVENT_DETAILS_PER_RUN=10
HLTV_MAX_TEAM_STATS_PER_RUN=20
HLTV_MAP_STATS_LOOKBACK_DAYS=90
HLTV_SCHEDULER_INTERVAL_SECONDS=900
HLTV_SERVICE_TOKEN=
HLTV_ALLOW_RAW_EVIDENCE=false
